{
  "name": "@seatlock/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client generated from docs/api/openapi.yaml. Never edit src/schema.d.ts by hand.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.yaml -o src/schema.d.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/schema.d.ts','dist/schema.d.ts')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@seatlock/eslint-config": "workspace:*",
    "@seatlock/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
