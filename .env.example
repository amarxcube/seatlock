# Copy to .env (git-ignored) and fill in the blanks. Used by docker compose and by the
# API/worker in development. Production values are set in the Render dashboard.

# ── API and worker ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
DATABASE_URL=postgresql://seatlock:seatlock@localhost:5433/seatlock
REDIS_URL=redis://localhost:6379
# The web app's origin; the only origin CORS allows.
WEB_ORIGIN=http://localhost:5173
# How often the worker's heartbeat job runs (ms).
WORKER_HEARTBEAT_MS=60000

# ── Web app (read at build time by Vite) ────────────────────────
VITE_API_URL=http://localhost:3000/api/v1

# ── Object storage (local RustFS; S3-compatible) ─────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=seatlock
S3_SECRET_KEY=seatlock-dev-secret
S3_BUCKET=covers

# ── Stripe (test mode only; keys start with sk_test_ / pk_test_) ─
# Used by the stripe-cli compose profile now, and by the API from Phase 5.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Printed by `stripe listen` (whsec_…).
STRIPE_WEBHOOK_SECRET=
