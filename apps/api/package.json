{
  "name": "@seatlock/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API (main.ts) and worker (worker.ts)",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "swc src -d dist --strip-leading-paths --copy-files && node scripts/copy-contract.mjs",
    "dev": "pnpm run build && concurrently -k -n swc,api,worker -c gray,blue,magenta \"swc src -d dist --strip-leading-paths -w\" \"node --watch dist/main.js\" \"node --watch dist/worker.js\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@seatlock/shared": "workspace:*",
    "bullmq": "6.4.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "uuidv7": "1.2.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@seatlock/eslint-config": "workspace:*",
    "@seatlock/tsconfig": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.20",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
